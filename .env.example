# Copy this file to .env and fill in local values.
# Never commit .env or paste real keys into source code.

# Pixabay API
PIXABAY_API_KEY=replace_with_your_pixabay_key

# Doubao TTS 2.0
# Set values according to the API credentials and endpoint you already use.
DOUBAO_TTS_BASE_URL=
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=

# ComfyUI on the second computer. Use a LAN-reachable address.
COMFYUI_BASE_URL=http://192.168.1.100:8188

# Optional: override local output path
ATLAS_WORKSPACE=./workspace
